---
import Icon from '@cloudflare/nimbus-docs/components/Icon.astro';
import {readPodcast} from '../../../plugins/podcast-player.mjs';
interface Props {id:string;title:string;src:string;duration:string;transcriptId:string;}
const {id,title,src,duration,transcriptId}=readPodcast(Astro.props);
---
<section {id} class="podcast" data-podcast-player aria-labelledby={`${id}-title`}>
  <header class="podcast-heading">
    <span class="podcast-icon" aria-hidden="true"><Icon name="ph:headphones" size={24} /></span>
    <div><p class="podcast-eyebrow">Podcast · {duration}</p><h2 id={`${id}-title`}>{title}</h2></div>
  </header>
  <div class="podcast-description"><slot /></div>
  <audio controls preload="none" aria-label={title}>
    <source {src} type="audio/mpeg" />
    <a href={src}>Listen to the MP3</a>.
  </audio>
  <div class="podcast-tools">
    <div class="podcast-links"><a href={`#${transcriptId}`}>Read transcript</a><a href={src} target="_blank" rel="noopener">Open MP3 <Icon name="ph:arrow-up-right" size={13} aria-hidden="true" /></a></div>
    <label class="podcast-speed" hidden>Speed <select aria-label="Podcast playback speed"><option value="0.75">0.75×</option><option value="1" selected>1×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option><option value="2">2×</option></select></label>
  </div>
  <p class="podcast-error" role="status" hidden>Audio could not load. Try <a href={src} target="_blank" rel="noopener">opening the MP3</a>.</p>
</section>
<script>
  import {mount} from '@cloudflare/nimbus-docs/client';
  mount('[data-podcast-player]',root=>{
    const audio=root.querySelector<HTMLAudioElement>('audio');
    const speed=root.querySelector<HTMLSelectElement>('select');
    const label=root.querySelector<HTMLElement>('.podcast-speed');
    const error=root.querySelector<HTMLElement>('.podcast-error');
    if(!audio||!speed||!label)return()=>{};
    const controller=new AbortController();const options={signal:controller.signal};
    label.hidden=false;
    speed.addEventListener('change',()=>{audio.playbackRate=Number(speed.value);},options);
    audio.addEventListener('ratechange',()=>{const value=String(audio.playbackRate);if([...speed.options].some(option=>option.value===value))speed.value=value;},options);
    audio.addEventListener('play',()=>{
      document.querySelectorAll<HTMLAudioElement>('[data-podcast-player] audio').forEach(other=>{if(other!==audio)other.pause();});
    },options);
    audio.addEventListener('error',()=>{if(error)error.hidden=false;},options);
    audio.querySelector('source')?.addEventListener('error',()=>{if(error)error.hidden=false;},options);
    audio.addEventListener('canplay',()=>{if(error)error.hidden=true;},options);
    document.addEventListener('click',event=>{
      if(!(event.target instanceof Element))return;
      const video=event.target.closest('[data-video-play],[data-video-select]');
      if(!video)return;
      if(event instanceof MouseEvent&&(event.button!==0||event.metaKey||event.ctrlKey||event.shiftKey||event.altKey))return;
      audio.pause();
    },options);
    return()=>{controller.abort();audio.pause();};
  });
</script>
<style>
  .podcast{min-width:0;margin:.25rem 0 1.75rem;padding:1.1rem 1.2rem 1rem;border:1px solid var(--nb-border);border-radius:.9rem;background:var(--nb-card,var(--nb-background));scroll-margin-top:5rem;}
  .podcast-heading{display:flex;align-items:center;gap:.8rem;}
  .podcast-icon{display:grid;place-items:center;flex:none;width:2.65rem;height:2.65rem;background:var(--nb-muted);border:1px solid var(--nb-border);border-radius:.75rem;}
  .podcast-eyebrow{font-size:.65rem;letter-spacing:.04em;color:var(--nb-muted-foreground);font-variant-numeric:tabular-nums;margin:0 0 .2rem!important;}
  h2{font-size:1.08rem;font-weight:600;line-height:1.45;letter-spacing:-.015em;margin:0!important;border:0;padding:0;}
  .podcast-description :global(p){font-size:.82rem;line-height:1.65;color:var(--nb-muted-foreground);margin:.85rem 0 1rem!important;}
  audio{display:block;width:100%;min-width:0;height:54px;}
  :global(html[data-mode='dark']) audio{color-scheme:dark;}
  .podcast-tools{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem .8rem;margin-top:.65rem;}
  .podcast-links{display:flex;align-items:center;flex-wrap:wrap;gap:1rem;}
  .podcast-links>a{display:inline-flex;align-items:center;gap:.2rem;min-height:2rem;font-size:.73rem;color:var(--nb-muted-foreground);text-decoration:none!important;}
  .podcast-links>a:hover{color:var(--nb-foreground);text-decoration:underline!important;}
  .podcast-speed{display:flex;align-items:center;gap:.45rem;font-size:.72rem;color:var(--nb-muted-foreground);}
  select{min-height:2rem;padding:.2rem .45rem;border:1px solid var(--nb-border);border-radius:.4rem;background:var(--nb-background);color:var(--nb-foreground);font-size:.75rem;}
  .podcast-speed[hidden],.podcast-error[hidden]{display:none!important;}
  .podcast-error{font-size:.8rem;line-height:1.6;margin:.75rem 0 0!important;}
  .podcast-links>a:focus-visible,select:focus-visible,audio:focus-visible{outline:2px solid var(--nb-ring);outline-offset:3px;}
  @media(max-width:400px){.podcast{padding:1rem;}.podcast-tools{gap:.4rem .6rem;}.podcast-links{gap:.75rem;}}
  @media print{audio,.podcast-speed{display:none!important;}.podcast{break-inside:avoid;}}
</style>

---
import {hardwareFigures,timingStages,timingFrames} from '../../../plugins/hardware-foundations.mjs';
interface Props {id:string; kind:'system'|'signal'|'memory'|'circuit'|'chip'|'timing';}
const {id,kind}=Astro.props;
const data=hardwareFigures[kind];
const wave=(frequency:number)=>Array.from({length:601},(_,i)=>`${i},${90-65*Math.cos(2*Math.PI*frequency*i/600)}`).join(' ');
const samples=Array.from({length:9},(_,i)=>({x:i*75,y:90-65*Math.cos(2*Math.PI*i/8)}));
---
<figure id={id} class:list={['hardware-figure',kind]}>
 <div class="hw-art">
  <header><span class="eyebrow">{data.eyebrow}</span><p class="hw-title">{data.title}</p><p class="hw-intro">{data.intro}</p></header>
  {kind==='circuit' && <>
   <svg class="circuit-svg" viewBox="0 0 360 270" role="img" aria-labelledby={`${id}-circuit-title ${id}-circuit-desc`}>
    <title id={`${id}-circuit-title`}>An ideal voltage source and resistor form a closed DC circuit</title>
    <desc id={`${id}-circuit-desc`}>{hardwareFigures.circuit.explanation}</desc>
    <defs><marker id={`${id}-current-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="var(--hw-gold)" /></marker></defs>
    <path d="M80 80V45H260V80 M260 150V205H80V140" class="circuit-wire" />
    <circle cx="80" cy="110" r="30" class="circuit-source" />
    <text x="80" y="102" class="circuit-polarity">+</text><text x="80" y="126" class="circuit-polarity">−</text>
    <rect x="250" y="80" width="20" height="70" rx="1" class="circuit-resistor" />
    <path d="M154 45H218" class="current-arrow" marker-end={`url(#${id}-current-arrow)`} />
    <path d="M220 205H161" class="current-arrow" marker-end={`url(#${id}-current-arrow)`} />
    <circle cx="80" cy="205" r="3.5" class="circuit-node" /><path d="M80 205V224 M65 224H95 M70 231H90 M76 238H84" class="circuit-ground" />
    <text x="185" y="26" text-anchor="middle" class="circuit-label">0.33 mA</text>
    <text x="80" y="26" text-anchor="middle" class="circuit-label">3.3 V</text>
    <text x="307" y="121" text-anchor="middle" class="circuit-label">10 kΩ</text>
    <text x="80" y="260" text-anchor="middle" class="circuit-small">0 V reference</text>
    <text x="222" y="234" text-anchor="middle" class="circuit-small">Return path</text>
   </svg>
   <p class="detail-explanation">{hardwareFigures.circuit.explanation}</p>
   <ul class="detail-readouts">{hardwareFigures.circuit.readouts.map(r=><li><span>{r.label}</span><strong>{r.value}</strong></li>)}</ul>
  </>}
  {kind==='chip' && <>
   <div class="detail-viewport" tabindex="0" role="region" aria-label="Scrollable board and chip diagram. Use arrow keys to pan.">
    <svg class="detail-svg board-svg" viewBox="0 0 600 330" role="img" aria-labelledby={`${id}-chip-title ${id}-chip-desc`}>
     <title id={`${id}-chip-title`}>A board contains a SoC and supporting chips; the SoC contains execution engines and controllers</title>
     <desc id={`${id}-chip-desc`}>{hardwareFigures.chip.explanation}</desc>
     <defs><pattern id={`${id}-board-grid`} width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" class="board-grid" /></pattern></defs>
     <rect x="14" y="28" width="572" height="284" rx="15" class="board-boundary" />
     <rect x="14" y="28" width="572" height="284" rx="15" fill={`url(#${id}-board-grid)`} />
     {[{x:28,y:42},{x:572,y:42},{x:28,y:298},{x:572,y:298}].map(p=><circle cx={p.x} cy={p.y} r="4" class="board-hole" />)}
     <text x="44" y="59" class="board-heading">BOARD</text>
     <path d="M150 138H165V224H180 M150 218H180 M450 136H476 M450 210H476 M314 272V257" class="board-trace" />
     <rect x="180" y="85" width="270" height="172" rx="8" class="soc-boundary" />
     <text x="195" y="108" class="soc-heading">SYSTEM ON A CHIP · SoC</text>
     {[{x:195,label:'CPU'},{x:276,label:'GPU*'},{x:357,label:'NPU*'}].map(engine=><g><rect x={engine.x} y="122" width="76" height="42" rx="4" class="engine-block" /><text x={engine.x+38} y="148" text-anchor="middle" class="engine-label">{engine.label}</text></g>)}
     <rect x="195" y="177" width="238" height="27" rx="3" class="local-block" /><text x="314" y="195" text-anchor="middle" class="board-label">Local SRAM / caches</text>
     <rect x="195" y="216" width="238" height="27" rx="3" class="local-block" /><text x="314" y="235" text-anchor="middle" class="board-label">Memory + I/O control / DMA</text>
     {[{x:35,y:118,w:115,label:'Sensor I/O'},{x:35,y:198,w:115,label:'USB / debug'},{x:476,y:117,w:88,label:'RAM'},{x:476,y:191,w:88,label:'Flash'}].map(part=><g><rect x={part.x} y={part.y} width={part.w} height="40" rx="4" class="board-part" /><text x={part.x+part.w/2} y={part.y+25} text-anchor="middle" class="board-label">{part.label}</text></g>)}
     <rect x="195" y="272" width="238" height="29" rx="4" class="power-part" /><text x="314" y="292" text-anchor="middle" class="board-label">Power regulation</text>
    </svg>
   </div>
   <p class="pan-help">Pan the diagram for detail on smaller screens.</p>
   <ul class="chip-roles">{hardwareFigures.chip.roles.map(role=><li><strong>{role.label}</strong><span>{role.detail}</span></li>)}</ul>
  </>}
  {kind==='timing' && <>
   <ol class="timing-legend">{timingStages.map((stage,i)=><li class={stage.tone}><span>{i+1}</span><strong>{stage.label}</strong><span>{stage.duration} ms</span></li>)}</ol>
   <div class="detail-viewport" tabindex="0" role="region" aria-label="Scrollable pipeline timing plot. Use arrow keys to pan.">
    <svg class="detail-svg timing-svg" viewBox="0 0 600 245" role="img" aria-labelledby={`${id}-timing-title ${id}-timing-desc`}>
     <title id={`${id}-timing-title`}>Three frames overlap, each taking 27 milliseconds and finishing 12 milliseconds apart</title>
     <desc id={`${id}-timing-desc`}>{hardwareFigures.timing.explanation}</desc>
     {[0,12,24,36,48].map(t=><g><line x1={82+t*8} x2={82+t*8} y1="43" y2="227" class="plot-grid" /><text x={82+t*8} y="28" text-anchor="middle" class="timing-tick">{t}</text></g>)}
     <text x="550" y="28" class="timing-tick">ms</text>
     {timingFrames.map((f,i)=><g><text x="5" y={87+i*62} class="timing-frame-label">{f.label}</text>{f.stages.map(stage=><g class={stage.tone}><rect x={82+stage.start*8} y={68+i*62} width={stage.duration*8} height="28" rx="2" class="timing-bar" /><text x={82+(stage.start+stage.duration/2)*8} y={87+i*62} text-anchor="middle" class="timing-stage-number">{stage.number}</text></g>)}<text x={90+f.end*8} y={87+i*62} class="timing-finish">{f.end} ms</text></g>)}
    </svg>
   </div>
   <p class="pan-help">Pan the timing plot for detail on smaller screens.</p>
   <p class="detail-explanation">{hardwareFigures.timing.explanation}</p>
   <ul class="detail-readouts timing-readouts"><li><span>Latency of each frame</span><strong>27 ms</strong></li><li><span>Completed results arrive every</span><strong>12 ms</strong></li></ul>
  </>}
  {kind==='system' && <>
   <div class="flows">{hardwareFigures.system.flows.map(f=><section class:list={['flow',f.tone]} aria-label={f.label}>
    <p class="flow-label"><span class="flow-dot" aria-hidden="true"></span>{f.label}</p>
    <ol class="flow-steps">{f.steps.map(step=><li>{step}</li>)}</ol>
    <p class="flow-detail">{f.detail}</p>
   </section>)}</div>
   <div class="scales"><p class="scale-heading">Zoom through five scales</p><ol>{hardwareFigures.system.scales.map((s,i)=><li><span class="scale-number">0{i+1}</span><strong>{s.label}</strong><span>{s.detail}</span></li>)}</ol></div>
  </>}
  {kind==='signal' && <>
   <ul class="signal-legend">{hardwareFigures.signal.labels.map((label,i)=><li><span class:list={['swatch','swatch-'+i]} aria-hidden="true"></span>{label}</li>)}</ul>
   <div class="signal-plot">
    <span class="axis-label">Normalized amplitude (−1 to 1)</span>
    <svg viewBox="0 0 600 180" role="img" aria-labelledby={`${id}-plot-title ${id}-plot-desc`}>
     <title id={`${id}-plot-title`}>Aliasing: one and seven hertz signals sampled at eight hertz</title>
     <desc id={`${id}-plot-desc`}>{hardwareFigures.signal.explanation}</desc>
     {[25,90,155].map(y=><line x1="0" x2="600" y1={y} y2={y} class="plot-grid" />)}
     {samples.map(s=><line x1={s.x} x2={s.x} y1="14" y2="166" class="plot-grid" />)}
     <polyline points={wave(7)} class="wave seven" />
     <polyline points={wave(1)} class="wave one" />
     {samples.map(s=><circle cx={s.x} cy={s.y} r="5" class="sample" />)}
    </svg>
    <div class="time-axis"><span>0</span><span>0.25</span><span>0.5</span><span>0.75</span><span>1 s</span></div>
   </div>
   <p class="signal-explanation">{hardwareFigures.signal.explanation}</p>
   <ol class="signal-steps">{hardwareFigures.signal.steps.map((step,i)=><li><span>0{i+1}</span>{step}</li>)}</ol>
  </>}
  {kind==='memory' && <>
   <ol class="memory-layers">{hardwareFigures.memory.layers.map((layer,i)=><li><div class="memory-label"><span class="scale-number">0{i+1}</span><strong>{layer.label}</strong><span class="memory-role">{layer.role}</span></div><p>{layer.detail}</p></li>)}</ol>
   <p class="memory-transfer"><span aria-hidden="true">↕</span>{hardwareFigures.memory.transfer}</p>
  </>}
  <p class="hw-note">{data.note}</p>
 </div>
 <figcaption><slot /></figcaption>
</figure>
<style>
 .hardware-figure{container-type:inline-size;margin:2rem 0;scroll-margin-top:5rem;min-width:0;--hw-teal:#15756c;--hw-gold:#92621b;--hw-violet:#7859a0;--hw-blue:#36739c;}
 :global(html[data-mode="dark"]) .hardware-figure{--hw-teal:#70cfbd;--hw-gold:#e2b778;--hw-violet:#bca2df;--hw-blue:#8fc1e5;}
 .hw-art{border:1px solid var(--nb-border);border-radius:1rem;padding:1.4rem;background:var(--nb-background);overflow:hidden;}
 .eyebrow{font-size:.65rem;letter-spacing:.12em;text-transform:uppercase;font-weight:650;color:var(--nb-muted-foreground);}
 .hw-title{font-weight:650;font-size:clamp(1.2rem,3cqi,1.7rem);letter-spacing:-.035em;line-height:1.2;margin:.55rem 0;}
 .hw-intro{font-size:.84rem;color:var(--nb-muted-foreground);line-height:1.6;margin:0 0 1.4rem;}
 .flow{padding:1rem 0;border-top:1px solid var(--nb-border);--flow-color:var(--hw-teal);}.flow.gold{--flow-color:var(--hw-gold);}.flow.violet{--flow-color:var(--hw-violet);}
 .flow-label{display:flex;align-items:center;gap:.45rem;color:var(--flow-color);font-size:.75rem;font-weight:650;margin:0 0 .7rem;}
 .flow-dot{width:.45rem;height:.45rem;flex-shrink:0;border-radius:50%;background:currentColor;}
 .flow-steps{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.75rem;}
 .flow-steps li{position:relative;padding:.55rem .4rem;text-align:center;background:color-mix(in srgb,var(--flow-color) 7%,var(--nb-background));border:1px solid color-mix(in srgb,var(--flow-color) 26%,var(--nb-border));border-radius:.4rem;font-size:.77rem;font-weight:600;margin:0;list-style:none;line-height:1.4;}
 .flow-steps li:not(:last-child)::after{content:'→';position:absolute;left:100%;width:.75rem;top:50%;transform:translateY(-50%);color:var(--flow-color);font-weight:400;}
 .flow-detail{font-size:.77rem;line-height:1.6;margin:.65rem 0 0;color:var(--nb-muted-foreground);}
 .scales{border-top:1px solid var(--nb-border);margin-top:.5rem;padding-top:1rem;}
 .scale-heading{font-size:.68rem;text-transform:uppercase;letter-spacing:.08em;font-weight:650;color:var(--nb-muted-foreground);margin:0 0 1rem;}
 .scales ol{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.8rem;}
 .scales li{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.3rem;min-width:0;}
 .scale-number{font-size:.63rem;color:var(--nb-muted-foreground);font-variant-numeric:tabular-nums;letter-spacing:.04em;}
 .scales strong{font-weight:600;font-size:.78rem;}.scales li>span:last-child{font-size:.71rem;line-height:1.5;color:var(--nb-muted-foreground);}
 .hw-note{font-size:.71rem;line-height:1.6;color:var(--nb-muted-foreground);border-top:1px solid var(--nb-border);padding-top:.9rem;margin:1.1rem 0 0;}
 .signal-legend{padding:0;margin:0 0 .9rem;list-style:none;display:flex;flex-wrap:wrap;gap:.5rem 1.2rem;font-size:.74rem;}
 .signal-legend li{display:flex;align-items:center;gap:.45rem;list-style:none;margin:0;padding:0;}
 .swatch{width:1.25rem;height:0;border-top:2px solid var(--hw-gold);}.swatch-1{border-top:2px dashed var(--hw-blue);}.swatch-2{width:.5rem;height:.5rem;background:var(--nb-foreground);border:0;border-radius:50%;}
 .signal-plot{padding:.8rem .5rem .2rem;background:color-mix(in srgb,var(--nb-muted-foreground) 3%,var(--nb-background));border-radius:.5rem;}
 .axis-label{display:block;font-size:.64rem;color:var(--nb-muted-foreground);margin-bottom:.3rem;}
 .signal-plot svg{display:block;width:100%;height:auto;overflow:visible;}.plot-grid{stroke:var(--nb-border);stroke-width:.8;}.wave{fill:none;stroke-width:2;vector-effect:non-scaling-stroke;}.seven{stroke:var(--hw-blue);stroke-dasharray:5 4;opacity:.85;}.one{stroke:var(--hw-gold);stroke-width:2.5;}.sample{fill:var(--nb-foreground);stroke:var(--nb-background);stroke-width:1.5;}
 .time-axis{display:flex;justify-content:space-between;font-size:.64rem;color:var(--nb-muted-foreground);font-variant-numeric:tabular-nums;}
 .circuit-svg{display:block;width:100%;max-width:24rem;height:auto;margin:.2rem auto 1rem;}
 .circuit-wire,.circuit-ground{fill:none;stroke:var(--hw-teal);stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;}.circuit-source{fill:var(--nb-background);stroke:var(--hw-teal);stroke-width:2.5;}.circuit-resistor{fill:color-mix(in srgb,var(--hw-gold) 12%,var(--nb-background));stroke:var(--hw-gold);stroke-width:2.5;}.current-arrow{fill:none;stroke:var(--hw-gold);stroke-width:2.5;}.circuit-node{fill:var(--hw-teal);}.circuit-label{font-size:18px;fill:var(--nb-foreground);font-weight:550;}.circuit-small{font-size:15px;fill:var(--nb-muted-foreground);}.circuit-polarity{fill:var(--nb-foreground);text-anchor:middle;font-size:23px;}
 .detail-readouts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.9rem;list-style:none;padding:1rem 0 0;margin:1rem 0 0;border-top:1px solid var(--nb-border);}.detail-readouts li{list-style:none;margin:0;display:flex;flex-direction:column;gap:.4rem;}.detail-readouts li>span{font-size:.72rem;line-height:1.5;color:var(--nb-muted-foreground);}.detail-readouts strong{font-size:1.2rem;font-weight:600;letter-spacing:-.02em;font-variant-numeric:tabular-nums;}
 .detail-viewport{min-width:0;overflow-x:auto;overscroll-behavior-inline:contain;border-radius:.5rem;}.detail-viewport:focus-visible{outline:2px solid var(--nb-foreground);outline-offset:3px;}.detail-svg{display:block;width:100%;min-width:560px;height:auto;}.pan-help{font-size:.67rem;color:var(--nb-muted-foreground);margin:.5rem 0 .8rem;}
 .board-boundary{fill:color-mix(in srgb,var(--hw-teal) 5%,var(--nb-background));stroke:var(--hw-teal);stroke-width:1.5;}.board-grid{stroke:var(--hw-teal);stroke-width:.5;fill:none;opacity:.1;}.board-hole{fill:var(--nb-background);stroke:var(--hw-teal);stroke-width:1;}.board-heading{font-size:13px;fill:var(--hw-teal);font-weight:650;letter-spacing:1.6px;}.board-trace{fill:none;stroke:var(--hw-gold);stroke-width:2;}.soc-boundary{fill:var(--nb-background);stroke:var(--hw-violet);stroke-width:2;}.soc-heading{font-size:12px;fill:var(--hw-violet);font-weight:650;letter-spacing:.5px;}.engine-block{fill:color-mix(in srgb,var(--hw-violet) 8%,var(--nb-background));stroke:var(--hw-violet);stroke-width:1;}.engine-label{font-size:17px;font-weight:600;fill:var(--nb-foreground);}.local-block,.board-part{fill:var(--nb-background);stroke:var(--nb-border);stroke-width:1.3;}.board-label{font-size:14px;fill:var(--nb-foreground);}.power-part{fill:color-mix(in srgb,var(--hw-gold) 10%,var(--nb-background));stroke:var(--hw-gold);stroke-width:1;}
 .chip-roles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;list-style:none;padding:0;margin:1rem 0 0;}.chip-roles li{display:flex;flex-direction:column;gap:.3rem;list-style:none;margin:0;}.chip-roles strong{font-size:.8rem;font-weight:600;}.chip-roles span{font-size:.74rem;line-height:1.6;color:var(--nb-muted-foreground);}.detail-explanation{font-size:.77rem;line-height:1.65;margin:1rem 0;}
 .timing-legend{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin:0 0 1rem;padding:0;gap:.75rem;}.timing-legend li{list-style:none;margin:0;display:flex;flex-wrap:wrap;align-items:center;gap:.25rem .4rem;font-size:.73rem;}.timing-legend li>span:first-child{display:grid;place-items:center;border:1px solid var(--timing-color);color:var(--timing-color);width:1.15rem;height:1.15rem;border-radius:.25rem;font-size:.65rem;font-weight:600;}.timing-legend strong{font-size:.73rem;font-weight:550;}.timing-legend li>span:last-child{color:var(--nb-muted-foreground);font-size:.67rem;}.teal{--timing-color:var(--hw-teal);}.blue{--timing-color:var(--hw-blue);}.violet{--timing-color:var(--hw-violet);}.gold{--timing-color:var(--hw-gold);}.timing-bar{fill:color-mix(in srgb,var(--timing-color) 13%,var(--nb-background));stroke:var(--timing-color);stroke-width:1;}.timing-stage-number{fill:var(--nb-foreground);font-size:12px;font-weight:600;}.timing-tick{fill:var(--nb-muted-foreground);font-size:14px;}.timing-frame-label,.timing-finish{fill:var(--nb-foreground);font-size:14px;}.timing-readouts{grid-template-columns:repeat(2,minmax(0,1fr));}
 .signal-explanation{font-size:.78rem;line-height:1.65;margin:1rem 0;}
 .signal-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem;padding:0;margin:1rem 0 0;list-style:none;}
 .signal-steps li{list-style:none;margin:0;border-left:2px solid var(--hw-teal);padding:0 0 0 .65rem;font-size:.74rem;line-height:1.5;}.signal-steps span{display:block;font-size:.6rem;color:var(--nb-muted-foreground);margin-bottom:.25rem;}
 .memory-layers{list-style:none;padding:0;margin:0;display:grid;gap:.7rem;}
 .memory-layers li{list-style:none;margin:0;padding:.9rem 1rem;border:1px solid var(--nb-border);border-left:3px solid var(--hw-teal);border-radius:.4rem;background:color-mix(in srgb,var(--hw-teal) 3%,var(--nb-background));}
 .memory-layers li:nth-child(2){border-left-color:var(--hw-blue);background:color-mix(in srgb,var(--hw-blue) 3%,var(--nb-background));}.memory-layers li:nth-child(3){border-left-color:var(--hw-gold);background:color-mix(in srgb,var(--hw-gold) 3%,var(--nb-background));}
 .memory-label{display:flex;align-items:baseline;flex-wrap:wrap;gap:.3rem .6rem;}.memory-label strong{font-size:.85rem;font-weight:600;}.memory-role{margin-left:auto;font-size:.64rem;color:var(--nb-muted-foreground);}.memory-layers p{font-size:.77rem;line-height:1.65;margin:.5rem 0 0;color:var(--nb-muted-foreground);}
 .memory-transfer{display:flex;align-items:center;gap:.8rem;font-size:.77rem;line-height:1.6;margin:1rem 0 0;}.memory-transfer>span{font-size:1.8rem;color:var(--hw-teal);}
 figcaption{font-size:.78rem;line-height:1.65;color:var(--nb-muted-foreground);margin:.7rem .15rem 0;}figcaption :global(p){margin:0;}figcaption :global(strong){font-weight:600;color:var(--nb-foreground);}
 @container(max-width:520px){.hw-art{padding:1rem;}.hw-intro{font-size:.8rem;}.flow-steps{gap:.4rem;}.flow-steps li{font-size:.66rem;padding:.45rem .1rem;}.flow-steps li:not(:last-child)::after{width:.4rem;font-size:.7rem;}.flow-detail{font-size:.76rem;}.scales ol{grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;}.scales li:last-child{grid-column:1/-1;}.signal-steps{grid-template-columns:1fr;gap:.7rem;}.signal-steps li{display:flex;gap:.6rem;align-items:baseline;}.memory-label{align-items:baseline;}.memory-role{margin-left:1.5rem;width:100%;}.memory-layers li{padding:.8rem;}.hw-note{font-size:.7rem;}}
 @container(max-width:290px){.flow-steps{grid-template-columns:1fr;gap:.5rem;}.flow-steps li{font-size:.76rem;}.flow-steps li:not(:last-child)::after{content:'↓';top:100%;left:50%;transform:translateX(-50%);height:.5rem;line-height:.5rem;}.scales ol{grid-template-columns:1fr;}.scales li:last-child{grid-column:auto;}}
 @container(min-width:610px){.pan-help{display:none;}}
 @container(max-width:520px){.detail-readouts:not(.timing-readouts){grid-template-columns:1fr;gap:.6rem;}.detail-readouts:not(.timing-readouts) li{flex-direction:row;align-items:baseline;justify-content:space-between;gap:.8rem;}.detail-readouts strong{font-size:1.05rem;white-space:nowrap;}.chip-roles{grid-template-columns:1fr;gap:.65rem;}.timing-legend{grid-template-columns:repeat(2,minmax(0,1fr));}}
 @media print{.detail-viewport{overflow:visible;}.detail-svg{min-width:0;}.pan-help{display:none;}}
 @media print{.hw-art{break-inside:avoid;}.hw-title{font-size:1.2rem;}.hw-art{padding:1rem;}}
</style>

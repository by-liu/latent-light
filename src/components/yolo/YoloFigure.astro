---
import {yoloBranches,yoloFigures,featureLevels,deviceStages} from '../../../plugins/yolo-figures.mjs';
interface Props {id:string;kind:'atlas'|'grid'|'pyramid'|'selection'|'device'}
const {id,kind}=Astro.props;const d=yoloFigures[kind];
---
<figure id={id} class:list={['yolo-figure',kind]}>
 <div class="art">
  <header><span class="eyebrow">{d.eyebrow}</span><p class="figure-title">{d.title}</p><p class="intro">{d.intro}</p></header>
  {kind==='atlas' && <>
   <div class="atlas-root"><span class="root-symbol" aria-hidden="true">◉</span><div><strong>Real-time object detection</strong><span>Where is it? What is it? Can the result arrive in time?</span></div></div>
   <div class="branches">{yoloBranches.map(b=><a href={b.href} class:list={['branch',b.tone]}><span class="branch-team">{b.team}</span><strong class="branch-name">{b.name}<span aria-hidden="true"> ↗</span></strong><span class="model-sequence">{b.models}</span><span class="branch-idea">{b.idea}</span></a>)}</div>
   <div class="status-strip"><span class="snapshot">2026 snapshot</span><p><strong>YOLO26</strong><span class="status released">Released</span></p><p><strong>YOLO27</strong><span class="status preview">Preview</span></p><p><strong>v14 paper</strong><span class="status withdrawn">Withdrawn</span></p></div>
  </>}
  {kind==='grid' && <div class="grid-layout">
   <svg viewBox="0 0 256 256" role="img" aria-labelledby={`${id}-title ${id}-desc`}><title id={`${id}-title`}>Original YOLO center-based responsibility</title><desc id={`${id}-desc`}>{yoloFigures.grid.explanation}</desc>
    <rect x="20" y="20" width="196" height="196" class="scene" />
    {Array.from({length:8},(_,i)=><><line x1={20+i*28} x2={20+i*28} y1="20" y2="216" class="gridline"/><line x1="20" x2="216" y1={20+i*28} y2={20+i*28} class="gridline"/></>)}
    <rect x="132" y="104" width="28" height="28" class="owner"/>
    <ellipse cx="154" cy="110" rx="29" ry="15" class="object"/>
    <rect x="118" y="88" width="72" height="44" class="true-box"/><circle cx="154" cy="110" r="4" class="center"/>
    <text x="20" y="242" class="svg-label">7 × 7 responsibility cells</text>
   </svg>
   <div class="tensor"><p class="tensor-label">Per cell</p><p class="tensor-formula"><span>2 × 5</span><span class="operator">+</span><span>20</span><span class="operator">=</span><strong>30</strong></p><p class="tensor-detail">Two boxes: x, y, w, h, confidence<br/>One shared class vector</p><div class="tensor-total"><span>7 × 7 × 30</span><strong>1,470 values</strong></div><p class="explanation">{yoloFigures.grid.explanation}</p></div>
  </div>}
  {kind==='pyramid' && <>
   <div class="pipeline"><div><span>01</span><strong>Backbone</strong><small>Extract a feature hierarchy</small></div><span class="flow-arrow" aria-hidden="true">→</span><div class="focal"><span>02</span><strong>Neck</strong><small>Fuse coarse and fine information</small></div><span class="flow-arrow" aria-hidden="true">→</span><div><span>03</span><strong>Detection head</strong><small>Predict at several scales</small></div></div>
   <div class="levels">{featureLevels.map((f,i)=><section><div class:list={['feature-grid','level-'+i]} aria-hidden="true"></div><div><span class="level-name">{f.level} · stride {f.stride}</span><strong>{f.width} × {f.width}</strong><span>{f.count.toLocaleString('en-US')} locations</span><small>{f.detail}</small></div></section>)}</div>
   <p class="total"><span>640 × 640 example</span><strong>8,400 prediction locations</strong></p><p class="explanation">{yoloFigures.pyramid.explanation}</p>
  </>}
  {kind==='selection' && <div class="selection-pair">
   {['dense','unique'].map((mode,i)=><section><p class="panel-label">{i===0?'Dense head + NMS':'One-to-one head'}</p><svg viewBox="0 0 280 188" role="img" aria-labelledby={`${id}-${mode}-title ${id}-${mode}-desc`}><title id={`${id}-${mode}-title`}>{i===0?'Several candidates, then suppression':'One selected prediction without NMS'}</title><desc id={`${id}-${mode}-desc`}>{i===0?'Three overlapping box candidates with illustrative scores 0.92, 0.84 and 0.76; the 0.92 candidate is kept by NMS.':'An illustrative one-to-one head selects one box with score 0.92; decoding, thresholds and top-k can still be applied.'}</desc>
    <rect x="8" y="8" width="264" height="172" rx="4" class="scene"/><ellipse cx="138" cy="104" rx="41" ry="27" class="object"/>
    {i===0 && <><rect x="70" y="54" width="136" height="100" class="duplicate"/><rect x="89" y="68" width="115" height="92" class="duplicate"/><text x="174" y="174" class="svg-small">0.84 · 0.76</text></>}
    <rect x="80" y="60" width="128" height="92" class="true-box"/><rect x="80" y="38" width="78" height="22" class="score-bg"/><text x="87" y="54" class="score">0.92 kept</text>
   </svg><p>{i===0?'Match several candidates during training; suppress overlapping detections at inference.':'Train toward unique assignment; select predictions without an IoU suppression pass.'}</p></section>)}
   <p class="explanation pair-explanation">{yoloFigures.selection.explanation}</p>
  </div>}
  {kind==='device' && <><ol class="device-stages">{deviceStages.map((s,i)=><li><span class="stage-number">0{i+1}</span><strong>{s.name}</strong><span>{s.detail}</span></li>)}</ol><div class="measurement"><span>Measure this full span</span><strong>Observation → useful result</strong><span>+ queues, transfers and scheduling</span></div><p class="explanation">{yoloFigures.device.explanation}</p></>}
  <p class="note">{d.note}</p>
 </div><figcaption><slot/></figcaption>
</figure>
<style>
.yolo-figure{container-type:inline-size;margin:2rem 0;scroll-margin-top:5rem;min-width:0;--gold:#92621b;--teal:#15756c;--soft:var(--nb-muted-foreground);--line:var(--nb-border);--ink:var(--nb-foreground);--paper:var(--nb-background);font-family:var(--nb-font-sans);}
:global(html[data-mode='dark']) .yolo-figure{--gold:#e2b778;--teal:#70cfbd;}
.art{border:1px solid var(--line);border-radius:8px;padding:clamp(1rem,3.5cqi,2rem);background:var(--paper);overflow:hidden;}
.eyebrow,.panel-label,.tensor-label,.branch-team,.snapshot{font-size:.64rem;letter-spacing:.11em;text-transform:uppercase;color:var(--soft);font-weight:600;}
.figure-title{font-size:clamp(1.6rem,4.5cqi,2.6rem);letter-spacing:-.055em;font-weight:600;line-height:1.12;margin:.7rem 0 1rem;max-width:24ch;}
.intro{font-size:.9rem;line-height:1.7;color:var(--soft);max-width:70ch;margin:0 0 1.5rem;}
.atlas-root{display:flex;gap:1rem;align-items:center;border-block:1px solid var(--line);padding:1.25rem 0;margin-bottom:1.25rem;}
.root-symbol{font-size:2.5rem;color:var(--gold);line-height:1;}.atlas-root strong,.atlas-root span:not(.root-symbol){display:block;}.atlas-root strong{font-size:1rem;font-weight:600;}.atlas-root div>span{font-size:.76rem;color:var(--soft);margin-top:.3rem;}
.branches{display:grid;grid-template-columns:1fr 1fr;gap:0 1.5rem;}
.branch{display:flex;flex-direction:column;border-bottom:1px solid var(--line);padding:1.15rem 0;text-decoration:none!important;color:var(--ink)!important;gap:.5rem;min-width:0;}
.branch:focus-visible{outline:2px solid var(--teal);outline-offset:5px;}.branch:hover .branch-name{color:var(--teal);}.branch-team{letter-spacing:.05em;font-size:.58rem;line-height:1.6;}.branch-name{font-size:.98rem;letter-spacing:-.025em;font-weight:600;line-height:1.4;}.branch-name>span{color:var(--soft);font-size:.78rem;}.model-sequence{font-size:.76rem;line-height:1.8;font-weight:500;}.branch-idea{font-size:.76rem;line-height:1.65;color:var(--soft);}.gold .branch-name{color:var(--gold);}.teal .branch-name{color:var(--teal);}
.status-strip{display:flex;align-items:center;flex-wrap:wrap;gap:.6rem 1.2rem;padding:1.3rem 0 0;}.status-strip p{display:flex;gap:.5rem;align-items:center;font-size:.72rem;margin:0;}.status-strip strong{font-weight:600;}.status{font-size:.61rem;padding:.14rem .3rem;border:1px solid var(--line);border-radius:2px;}.released{color:var(--teal);}.preview{color:var(--gold);}.withdrawn{border-style:dashed;color:var(--soft);}
.note{font-size:.71rem;line-height:1.75;color:var(--soft);border-top:1px solid var(--line);padding-top:1rem;margin:1.3rem 0 0;}.explanation{font-size:.8rem;line-height:1.75;color:var(--soft);margin:1rem 0 0;}figcaption{font-size:.8rem;line-height:1.7;color:var(--soft);margin-top:.65rem;}
.grid-layout{display:grid;grid-template-columns:minmax(160px,.85fr) minmax(0,1.15fr);gap:1.5rem;align-items:center;}.grid-layout svg{width:100%;max-width:320px;margin:auto;}.scene{fill:color-mix(in srgb,var(--ink) 2%,var(--paper));stroke:var(--line);}.gridline{stroke:var(--line);stroke-width:1;}.owner{fill:color-mix(in srgb,var(--gold) 24%,var(--paper));stroke:var(--gold);stroke-width:1.5;}.object{fill:color-mix(in srgb,var(--gold) 24%,var(--paper));}.true-box{fill:none;stroke:var(--teal);stroke-width:2;}.center{fill:var(--gold);}.svg-label{font-size:14px;fill:var(--soft);}.tensor-label{margin:0;}.tensor-formula{display:flex;gap:.7rem;align-items:center;font-size:clamp(1.3rem,4cqi,2rem);font-variant-numeric:tabular-nums;font-weight:500;letter-spacing:-.035em;margin:.65rem 0;}.tensor-formula strong{color:var(--gold);}.operator{font-size:1rem;color:var(--soft);}.tensor-detail{font-size:.75rem;line-height:1.8;color:var(--soft);}.tensor-total{display:flex;flex-wrap:wrap;gap:.5rem 1rem;border-block:1px solid var(--line);padding:.8rem 0;font-size:.82rem;}.tensor-total strong{color:var(--teal);font-weight:600;}
.pipeline{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:center;gap:.7rem;}.pipeline>div{border:1px solid var(--line);border-radius:4px;padding:.85rem;display:flex;flex-direction:column;gap:.4rem;}.pipeline span:not(.flow-arrow){font-size:.6rem;color:var(--soft);}.pipeline strong{font-size:.85rem;font-weight:600;}.pipeline small{font-size:.68rem;line-height:1.6;color:var(--soft);}.pipeline .focal{border-color:var(--gold);}.flow-arrow{color:var(--soft);}
.levels{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;margin:1.75rem 0;}.levels section{border-top:1px solid var(--line);padding-top:1rem;}.levels section>div:last-child{display:flex;flex-direction:column;gap:.4rem;}.level-name{font-size:.67rem;color:var(--teal);font-weight:600;}.levels strong{font-size:1.25rem;font-weight:500;letter-spacing:-.04em;}.levels span:not(.level-name){font-size:.74rem;}.levels small{font-size:.68rem;line-height:1.6;color:var(--soft);}.feature-grid{width:80px;height:80px;margin:0 0 1rem;border:1px solid var(--teal);background-color:color-mix(in srgb,var(--teal) 8%,var(--paper));background-image:linear-gradient(to right,var(--line) 1px,transparent 1px),linear-gradient(to bottom,var(--line) 1px,transparent 1px);background-size:8px 8px;}.level-1{background-size:16px 16px;}.level-2{background-size:40px 40px;}.total{display:flex;justify-content:space-between;gap:.7rem;flex-wrap:wrap;font-size:.8rem;border-block:1px solid var(--line);padding:.85rem 0;}.total span{color:var(--soft);}.total strong{font-weight:600;color:var(--teal);}
.selection-pair{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;}.selection-pair svg{width:100%;}.panel-label{font-size:.67rem;margin:0 0 .7rem;}.selection-pair section>p:last-child{font-size:.76rem;line-height:1.7;margin:.6rem 0 0;}.duplicate{fill:none;stroke:var(--soft);stroke-width:1.5;stroke-dasharray:5 4;}.svg-small{font-size:12px;fill:var(--soft);}.score-bg{fill:var(--teal);}.score{fill:var(--paper);font-size:13px;}.pair-explanation{grid-column:1/-1;margin-top:0;}
.device-stages{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));list-style:none;padding:0;margin:0;gap:1rem;}.device-stages li{display:flex;flex-direction:column;gap:.6rem;border-top:2px solid var(--line);padding-top:.8rem;min-width:0;}.device-stages li:nth-child(3){border-color:var(--gold);}.stage-number{font-size:.64rem;color:var(--soft);}.device-stages strong{font-size:.9rem;font-weight:600;}.device-stages li>span:last-child{font-size:.7rem;line-height:1.65;color:var(--soft);}.measurement{display:flex;flex-direction:column;gap:.4rem;align-items:center;border-top:1px solid var(--teal);margin-top:1.5rem;padding-top:.8rem;}.measurement span{font-size:.69rem;color:var(--soft);}.measurement strong{font-size:1.1rem;letter-spacing:-.035em;font-weight:500;color:var(--teal);}
@container(max-width:560px){.branches{grid-template-columns:1fr;}.branch{padding:1rem 0;}.branch-team{font-size:.6rem;}.model-sequence{font-size:.75rem;}.status-strip .snapshot{flex-basis:100%;}.grid-layout{grid-template-columns:1fr;gap:.5rem;}.grid-layout svg{max-width:260px;}.pipeline{grid-template-columns:1fr;gap:.5rem;}.flow-arrow{transform:rotate(90deg);justify-self:center;}.pipeline>div{display:grid;grid-template-columns:auto 1fr;gap:.25rem .8rem;}.pipeline small{grid-column:2;}.levels{gap:1rem;}.feature-grid{width:56px;height:56px;}.device-stages{grid-template-columns:1fr;gap:0;}.device-stages li{display:grid;grid-template-columns:1.5rem 4.5rem 1fr;align-items:baseline;border-top:1px solid var(--line);padding:.85rem 0;gap:.5rem;}.device-stages li:nth-child(3){border-color:var(--line);}.device-stages li:nth-child(3) strong{color:var(--gold);}.selection-pair{grid-template-columns:1fr;}.selection-pair svg{max-width:330px;display:block;margin:auto;}}
@media print{.art{break-inside:avoid;background:#fff;}.branches{grid-template-columns:1fr 1fr;}.branch-name>span{display:none;}.figure-title{font-size:22pt;}.yolo-figure{--paper:#fff;--ink:#161616;--soft:#505050;--gold:#805516;--teal:#126158;--line:#ccc;}.atlas .art{break-inside:auto;}.branch{break-inside:avoid;}}
</style>

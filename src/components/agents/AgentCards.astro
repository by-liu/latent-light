---
import {readAgentData} from '../../../plugins/agent-presentation.mjs';
interface Props {cardsJson:string; label?:string; compact?:boolean;}
const {cardsJson,label='Explore this collection',compact=false}=Astro.props;
const cards=readAgentData(cardsJson,'cards');
---
<nav class:list={['agent-cards',{compact}]} aria-label={label}>
  {cards.map((card,i)=><a href={card.href} style={`--card-index:${i}`}>
    {card.eyebrow && <span class="eyebrow">{card.eyebrow}</span>}
    <strong>{card.title}<span aria-hidden="true">↗</span></strong>
    <p>{card.description}</p>
  </a>)}
</nav>
<style>
  .agent-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.85rem;margin:1.35rem 0 1.8rem;}
  a{display:block;min-width:0;padding:1.2rem 1.25rem;border:1px solid var(--nb-border);border-radius:.8rem;background:var(--nb-card,var(--nb-background));color:var(--nb-foreground);text-decoration:none!important;transition:border-color .15s ease,background .15s ease;}
  a:hover{border-color:var(--nb-primary);background:color-mix(in srgb,var(--nb-primary) 4%,var(--nb-background));}
  a:focus-visible{outline:2px solid var(--nb-ring);outline-offset:4px;}
  .eyebrow{display:block;font-size:.68rem;letter-spacing:.085em;text-transform:uppercase;color:var(--nb-muted-foreground);margin-bottom:.55rem;font-weight:600;}
  strong{display:flex;justify-content:space-between;gap:.7rem;align-items:baseline;font-size:1.05rem;line-height:1.4;letter-spacing:-.02em;}
  strong span{font-weight:400;color:var(--nb-muted-foreground);font-size:.95rem;}
  p{font-size:.87rem;line-height:1.6;color:var(--nb-muted-foreground);margin:.55rem 0 0;}
  .compact a{padding:1rem 1.15rem;}.compact p{font-size:.85rem;}
  a:last-child:nth-child(odd){grid-column:1 / -1;}
  @media(max-width:620px){.agent-cards{grid-template-columns:1fr;gap:.65rem;}a{padding:1rem 1.1rem;}}
  @media(prefers-reduced-motion:reduce){a{transition:none;}}
  @media print{a{break-inside:avoid;background:white;}}
</style>

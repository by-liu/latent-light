---
import Icon from '@cloudflare/nimbus-docs/components/Icon.astro';
import { readModelResources } from '../../../plugins/model-resources.mjs';
interface Props {
  reportHref: string;
  modelHref: string;
  modelName: string;
  reportLabel?: string;
  reportNote?: string;
}
const resources = readModelResources(Astro.props);
---
<nav class="model-resources" aria-label="Original model resources">
  {resources.map(resource => <a href={resource.href} target="_blank" rel="noopener noreferrer" data-model-resource={resource.kind}>
    <Icon name={resource.kind === 'report' ? 'ph:file-text' : 'ph:cube'} class="resource-icon" />
    <span class="resource-copy"><strong>{resource.label}</strong><span>{resource.note}</span></span>
    <Icon name="ph:arrow-up-right" class="resource-arrow" />
  </a>)}
</nav>
<style>
  .model-resources{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:0 0 1.8rem;}
  .model-resources a{display:flex;align-items:center;gap:.75rem;min-width:0;padding:.9rem 1rem;border:1px solid var(--nb-border);border-radius:.75rem;text-decoration:none!important;background:var(--nb-card,var(--nb-background));color:var(--nb-foreground);}
  .model-resources a:hover{border-color:var(--nb-primary);background:var(--nb-accent);}
  .model-resources a:focus-visible{outline:2px solid var(--nb-primary);outline-offset:3px;}
  .resource-copy{min-width:0;flex:1;}.resource-copy strong{display:block;font-size:.9rem;line-height:1.4;}.resource-copy span{display:block;margin-top:.25rem;font-size:.75rem;line-height:1.5;color:var(--nb-muted-foreground);overflow-wrap:anywhere;}
  .model-resources :global(.resource-icon){width:1.25rem;height:1.25rem;flex-shrink:0;color:var(--nb-primary);}
  .model-resources :global(.resource-arrow){width:.9rem;height:.9rem;flex-shrink:0;color:var(--nb-muted-foreground);}
  @media(max-width:480px){.model-resources{grid-template-columns:1fr;gap:.6rem;}.model-resources a{padding:.8rem .9rem;}}
  @media print{.model-resources a{background:transparent;}}
</style>

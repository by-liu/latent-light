---
import videos from '../../data/jensen-videos.json';
import '@fontsource-variable/inter';
const categories=['All','Building & Leading','Technology & the Future','Life & Growth'];
const featured=videos.find(v=>v.id==='lXLBTBBil2U')!;
const spotlight=videos[0];
const queue=videos.slice(1,5);
const formats=[...new Set(videos.map(v=>v.format))].sort();
const years=[...new Set(videos.map(v=>v.year))].sort((a,b)=>b-a);
const publisherNames:Record<string,string>={'Stanford Graduate School of Business':'Stanford GSB','No Priors: AI, Machine Learning, Tech, & Startups':'No Priors','Stanford Institute for Economic Policy Research (SIEPR)':'Stanford SIEPR','Computer History Museum':'Computer History Museum','Bloomberg Television':'Bloomberg','Bloomberg Podcasts':'Bloomberg','PowerfulJRE':'Joe Rogan Experience','caltech':'Caltech'};
const canonical=new URL('/jensen/',Astro.site||'http://localhost:4327');
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Jensen Huang · Shine On You Crazy Diamond | Latent Light</title><meta name="description" content="A personal collection of Jensen Huang’s talks and interviews. Explore entrepreneurship, technology and growth; search topics and save videos for later."/><link rel="canonical" href={canonical}/><meta property="og:title" content="Jensen Huang · Shine On You Crazy Diamond"/><meta property="og:description" content="A personal tribute to Jensen Huang’s vision, resilience and inspiration, through his talks and conversations."/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><meta name="color-scheme" content="light"/><link rel="icon" href="/favicon.ico"/></head>
<body>
<a class="skip" href="#collection">Skip to the collection</a>
<header><a class="brand" href="/" aria-label="Latent Light home"><img src="/favicon.ico" width="22" height="22" alt=""/><span>Latent Light</span></a><span class="header-note">THE JENSEN COLLECTION</span><nav aria-label="Collection navigation"><a href="#personal-tribute">A personal note</a><a href="#collection">Watch & listen ↗</a></nav></header>
<main data-pagefind-body>
<section class="hero" aria-labelledby="intro-title">
<div class="hero-copy"><p class="eyebrow">FOR JENSEN HUANG · A PERSONAL TRIBUTE</p>
<h1 id="intro-title" class="shine-title">Shine on<br/>you crazy<br/><span>diamond.</span></h1>
<a class="song-note" href="https://www.youtube.com/watch?v=Pd-qu_ErkbE" target="_blank" rel="noopener" aria-label="Listen to Shine On You Crazy Diamond by Pink Floyd on YouTube"><span class="song-play" aria-hidden="true">▶</span><span>Pink Floyd <span aria-hidden="true">·</span> Listen on YouTube ↗</span></a>
<p class="dedication">The vision to see it. The courage to build it.</p>
<p class="intro hero-intro">His vision helped change computing. His optimism changed the way I face each day. This is my thank-you to Jensen Huang, and to the people who helped make the impossible real.</p>
<div class="hero-actions"><a class="primary" href="#collection">Explore the conversations <span aria-hidden="true">↗</span></a><a class="letter-link" href="#personal-tribute">Read my tribute ↓</a></div>
<p class="hero-meta">{videos.length} recordings <span> / </span> One endlessly curious mind.</p></div>
<figure class="feature tribute-feature"><div class="photo-heading"><span>THE ENGINEER BEHIND THE VISION</span><span class="diamond-mark" aria-hidden="true">◇</span></div><div class="feature-image tribute-image"><img src="/figures/jensen/jensen-davos-2026.webp" data-tribute-motion="/figures/jensen/jensen-davos-2026-motion.webp" data-still="/figures/jensen/jensen-davos-2026.webp" alt="Jensen Huang in his black leather jacket, gesturing while speaking at the World Economic Forum in Davos on January 21, 2026. A real photograph with a looping camera movement." fetchpriority="high" width="840" height="560"/></div>
<figcaption class="feature-info"><div class="photo-caption"><p class="eyebrow">IN CONVERSATION · DAVOS 2026</p><button class="feature-watch" hidden data-play={featured.id}>Meet the person <span aria-hidden="true">↗</span></button></div><p class="illustration-credit">© 2026 World Economic Forum / Thibaut Bouvier · <a href="https://www.flickr.com/photos/worldeconomicforum/55053488739" target="_blank" rel="noopener">Photo</a> · <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener">CC BY-NC-SA 4.0</a><br/>Cropped and animated with a gentle camera movement.</p></figcaption></figure>
</section>
<details id="personal-tribute" class="personal-tribute"><summary><span class="eyebrow">A PERSONAL NOTE</span><span>What his story means to me.</span><span class="note-toggle" aria-hidden="true">+</span></summary><div class="intro tribute-copy"><p>To me, Jensen Huang is the greatest entrepreneur of our time and a true godfather of AI. He helped lead a revolution. But what inspires me most is the optimism, conviction and resilience he asks of others. He lives those qualities himself.</p><p>As a Chinese American immigrant who began with humble roots, he built something that once seemed impossible. His story embodies the American dream. His vision and persistence have given me energy and courage to meet each day with hope.</p><p>Jensen stepped down as NVIDIA’s CEO on November 11, 2026. The company announced it publicly on November 12.<sup id="resignation-reference"><a href="#resignation-source" aria-label="Source for resignation dates">1</a></sup></p><p>I believe this is only a pause in his work with the company he has poured his life into. I look forward to his return and to the extraordinary things he can still build. I will always support him. I hope to see him return to leadership and keep building, inspiring and leading the way forward.</p><p class="thank-you">This collection is my way of saying thank you.</p><p class="letter-signoff">With admiration,<br/><strong>Latent Light</strong></p><p id="resignation-source" class="tribute-source">1. NVIDIA, <a href="https://www.sec.gov/Archives/edgar/data/1045810/000104581026000082/nvda-20261111.htm" target="_blank" rel="noopener">SEC filing, Item 5.02</a> (effective date) and <a href="https://nvidianews.nvidia.com/news/nvidia-announces-ceo-transition/" target="_blank" rel="noopener">CEO transition announcement</a> (November 12, 2026). <a href="#resignation-reference" aria-label="Return to resignation dates">↩</a></p></div></details>
<section class="collection" id="collection" aria-labelledby="collection-title"><div class="section-top"><div><p class="eyebrow">THE COLLECTION</p><h2 id="collection-title">Good conversations.<br/><em>Worth your time.</em></h2></div><p>Pick a conversation. Settle in. Stay curious.</p></div>
<section id="watch" class="watch-layout" aria-labelledby="player-title">
<div class="watch-main"><div class="player-frame"><a class="player-poster" href={spotlight.url} target="_blank" rel="noopener" data-play-link={spotlight.id} aria-label={`Play: ${spotlight.heading}`}><img src={spotlight.thumbnail} alt="" width="480" height="360" loading="lazy"/><span class="poster-play" aria-hidden="true">▶</span><span class="poster-label">Watch the conversation</span></a><div class="embed-slot"></div></div>
<div class="playing-heading"><p class="eyebrow player-status" aria-live="polite">START HERE</p><button class="stop-player" type="button" hidden>Stop playback <span aria-hidden="true">×</span></button></div>
<h3 id="player-title" tabindex="-1">{spotlight.heading}</h3><p class="player-meta">{spotlight.publisher} · {spotlight.year} · {spotlight.format}</p><p class="player-description">{spotlight.note}</p>
<div class="player-links"><a class="player-source" href={spotlight.url} target="_blank" rel="noopener">Open on YouTube ↗</a><a class="player-transcript" href={spotlight.transcriptUrl} target="_blank" rel="noopener">Read transcript ↗</a><span class="player-steps" hidden><button type="button" class="previous-video" aria-label="Play previous video in results">← Previous</button><button type="button" class="next-video" aria-label="Play next video in results">Next →</button></span></div></div>
<aside class="watch-queue" aria-label="More conversations"><p class="eyebrow">MORE TO EXPLORE</p><div class="queue-list">{queue.map(v=><a class="queue-item" href={v.url} data-play-link={v.id} target="_blank" rel="noopener"><span class="queue-thumbnail"><img src={v.thumbnail} alt="" width="480" height="360" loading="lazy"/><span aria-hidden="true">▶</span></span><span><small>{publisherNames[v.publisher]||v.publisher} · {v.year}</small><strong>{v.heading}</strong><span class="queue-format">{v.format}</span></span></a>)}</div></aside>
</section>
<div class="library-heading"><h3>All conversations <span>{videos.length}</span></h3><span>Make room for a new perspective.</span></div>
<form class="filters" role="search" hidden><label class="search"><span aria-hidden="true">⌕</span><span class="sr">Search videos</span><input name="q" type="search" placeholder="Search hosts, topics, events…" autocomplete="off"/></label><label class="year"><span class="sr">Filter by year</span><select name="year"><option value="all">All years</option>{years.map(y=><option value={y}>{y}</option>)}</select></label><label class="year"><span class="sr">Filter by format</span><select name="format"><option value="all">All formats</option>{formats.map(f=><option value={f}>{f}</option>)}</select></label><button class="saved-filter" type="button" aria-pressed="false">Watch later <span data-save-count>0</span></button></form>
<div class="topics" role="group" aria-label="Video topics" hidden>{categories.map((c,i)=><button type="button" data-category={c} aria-pressed={i===0?'true':'false'}>{c}</button>)}</div>
<div class="result-line"><p class="result" aria-live="polite" aria-atomic="true">{videos.length} selected videos</p><button type="button" class="clear" hidden>Clear filters</button></div>
<div class="cards">{videos.map(v=><article class="video-card" id={`video-${v.id}`} data-format={v.format} data-id={v.id} data-year={v.year} data-category={v.category} data-search={[v.title,v.publisher,v.heading,v.note,v.format,...v.tags].join(' ').toLowerCase()}><a class="thumbnail" href={v.url} target="_blank" rel="noopener" data-play-link={v.id} aria-label={`Watch: ${v.heading}`}><img src={v.thumbnail} alt={`${v.publisher} video thumbnail: ${v.title}`} width="480" height="360" loading="lazy"/><span class="card-play" aria-hidden="true">▶</span></a><div class="card-meta"><span>{v.format} <span aria-hidden="true">·</span> {v.year}</span><button type="button" class="save" data-save={v.id} aria-label={`Save for later: ${v.heading}`} aria-pressed="false" hidden>＋ Save</button></div><h3><a href={v.url} target="_blank" rel="noopener" data-play-link={v.id}>{v.heading}</a></h3><details class="card-details"><summary>About this recording <span aria-hidden="true">+</span></summary><p class="original-title" lang="en">{v.title}</p><p class="card-note">{v.note}</p>{'transcriptUrl' in v && <a class="transcript-link" href={v.transcriptUrl} target="_blank" rel="noopener">Read the host’s transcript ↗</a>}</details><div class="card-bottom"><a href={v.publisherUrl} target="_blank" rel="noopener" title={v.publisher}>{publisherNames[v.publisher]||v.publisher} ↗</a><a href={v.url} target="_blank" rel="noopener" class="source-link">YouTube ↗</a></div></article>)}</div>
<div class="empty" hidden><span aria-hidden="true">○</span><h3>A different search might lead somewhere new.</h3><p>Try “AI”, “entrepreneurship” or “GTC”, or clear your filters.</p><button type="button" class="empty-reset">Show all videos</button></div>
</section>
<section class="archive" aria-labelledby="archive-title"><p class="eyebrow">EARLIER VOICES</p><h2 id="archive-title">Before the AI spotlight.</h2><p>Go back to Stanford’s original archive for earlier lessons on building a company.</p><div class="archive-links"><a href="https://stvp.stanford.edu/av/how-ceo-spends-time" target="_blank" rel="noopener"><span>2003 · ARCHIVE EXCERPT</span><strong>How a CEO Spends Time ↗</strong><small>Stanford Technology Ventures Program</small></a><a href="https://stvp.stanford.edu/av/vision-matters" target="_blank" rel="noopener"><span>2009 · ARCHIVE TALK</span><strong>Vision Matters ↗</strong><small>Stanford Technology Ventures Program</small></a></div></section>
<section id="about" class="about"><p class="eyebrow">A NOTE FROM LATENT LIGHT</p><h2>Some voices are worth returning to.</h2><div><p>This collection began with an appreciation for Jensen Huang’s talks and his journey as an entrepreneur. It offers a quiet place to hear him speak about technology, building and life.</p><p>An unofficial personal collection by Latent Light. Videos remain with their original publishers and rights holders; this page provides curation and embedded playback. Audio is in English; caption options depend on YouTube. Formats distinguish podcasts, interviews, keynotes, oral history and edited profiles. The Caltech entry is the complete ceremony, including the commencement address.</p><p>Videos play directly on this page. The YouTube player loads only when you choose to watch. If embedding is unavailable, open the original video. Your Watch later list stays in this browser and is not uploaded.</p><a href="/jensen/index.md">Video list & sources ↗</a></div></section>
</main>
<footer><a class="brand" href="/">Latent Light</a><span>CURATED WITH CARE · 2026.11.12</span><a href="#intro-title">Back to top ↑</a></footer>
<p class="toast" role="status" aria-live="polite"></p>
<script>
import recordings from '../../data/jensen-videos.json';
const tributeImage=document.querySelector<HTMLImageElement>('img[data-tribute-motion]');if(tributeImage){const reduced=matchMedia('(prefers-reduced-motion: reduce)');const printMedia=matchMedia('print');let visible=false;let printing=false;const update=()=>{const src=visible&&!document.hidden&&!reduced.matches&&!printMedia.matches&&!printing?tributeImage.dataset.tributeMotion!:tributeImage.dataset.still!;if(tributeImage.getAttribute('src')!==src)tributeImage.src=src;};new IntersectionObserver(entries=>{visible=entries.some(e=>e.isIntersecting);update();},{threshold:.1}).observe(tributeImage);reduced.addEventListener('change',update);printMedia.addEventListener('change',update);document.addEventListener('visibilitychange',update);window.addEventListener('beforeprint',()=>{printing=true;update();});window.addEventListener('afterprint',()=>{printing=false;update();});}
const cards=Array.from(document.querySelectorAll<HTMLElement>('.video-card'));
const form=document.querySelector<HTMLFormElement>('.filters')!;const input=form.querySelector<HTMLInputElement>('input')!;const year=form.querySelector<HTMLSelectElement>('select[name=year]')!;const format=form.querySelector<HTMLSelectElement>('select[name=format]')!;
const topics=document.querySelector<HTMLElement>('.topics')!;const savedFilter=document.querySelector<HTMLButtonElement>('.saved-filter')!;const clear=document.querySelector<HTMLButtonElement>('.clear')!;const empty=document.querySelector<HTMLElement>('.empty')!;const toast=document.querySelector<HTMLElement>('.toast')!;
let saved=new Set<string>();let category='All';let onlySaved=false;let timer:number;
try{const s=JSON.parse(localStorage.getItem('ll-jensen-saved')||'[]');if(Array.isArray(s))saved=new Set(s.filter(x=>typeof x==='string'&&cards.some(c=>c.dataset.id===x)));}catch{}
const params=new URLSearchParams(location.search);input.value=params.get('q')||'';if([...year.options].some(o=>o.value===params.get('year')))year.value=params.get('year')!;if([...topics.querySelectorAll('button')].some(b=>b.dataset.category===params.get('topic')))category=params.get('topic')!;if([...format.options].some(o=>o.value===params.get('format')))format.value=params.get('format')!;onlySaved=params.get('saved')==='1';
function apply(){const terms=input.value.toLocaleLowerCase().trim().split(/\s+/).filter(Boolean);let count=0;for(const c of cards){const show=(category==='All'||c.dataset.category===category)&&(year.value==='all'||c.dataset.year===year.value)&&(format.value==='all'||c.dataset.format===format.value)&&(!onlySaved||saved.has(c.dataset.id!))&&terms.every(t=>c.dataset.search!.includes(t));c.hidden=!show;if(show)count++;}document.querySelector('.result')!.textContent=`${count} / ${cards.length} videos${onlySaved?' · Watch later':''}`;empty.hidden=count!==0;clear.hidden=!input.value&&year.value==='all'&&format.value==='all'&&category==='All'&&!onlySaved;topics.querySelectorAll('button').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.category===category)));savedFilter.setAttribute('aria-pressed',String(onlySaved));document.querySelector('[data-save-count]')!.textContent=String(saved.size);document.querySelectorAll<HTMLButtonElement>('[data-save]').forEach(b=>{const isSaved=saved.has(b.dataset.save!);b.setAttribute('aria-pressed',String(isSaved));b.textContent=isSaved?'✓ Saved':'＋ Save';});const p=new URLSearchParams();if(input.value.trim())p.set('q',input.value.trim());if(year.value!=='all')p.set('year',year.value);if(format.value!=='all')p.set('format',format.value);if(category!=='All')p.set('topic',category);if(onlySaved)p.set('saved','1');try{history.replaceState(null,'',location.pathname+(p.size?'?'+p.toString():'')+location.hash);}catch{}}
form.hidden=false;topics.hidden=false;document.querySelector<HTMLButtonElement>('.feature-watch')!.hidden=false;document.querySelectorAll<HTMLButtonElement>('.save').forEach(b=>{b.hidden=false;b.addEventListener('click',()=>{const id=b.dataset.save!;saved.has(id)?saved.delete(id):saved.add(id);let persisted=true;try{localStorage.setItem('ll-jensen-saved',JSON.stringify([...saved]));}catch{persisted=false;}apply();toast.textContent=persisted?(saved.has(id)?'Added to Watch later':'Removed from Watch later'):'Updated for this visit. Browser storage is unavailable; this list will reset when you reload.';clearTimeout(timer);timer=window.setTimeout(()=>toast.textContent='',3000);});});
form.addEventListener('submit',e=>e.preventDefault());input.addEventListener('input',apply);year.addEventListener('change',apply);format.addEventListener('change',apply);topics.querySelectorAll<HTMLButtonElement>('button').forEach(b=>b.addEventListener('click',()=>{category=b.dataset.category!;apply();}));savedFilter.addEventListener('click',()=>{onlySaved=!onlySaved;apply();});function reset(){input.value='';year.value='all';format.value='all';category='All';onlySaved=false;apply();input.focus();}clear.addEventListener('click',reset);document.querySelector('.empty-reset')!.addEventListener('click',reset);apply();
const watch=document.querySelector<HTMLElement>('#watch')!;
const frame=watch.querySelector<HTMLElement>('.embed-slot')!;
const poster=watch.querySelector<HTMLAnchorElement>('.player-poster')!;
const title=watch.querySelector<HTMLElement>('#player-title')!;
const stop=watch.querySelector<HTMLButtonElement>('.stop-player')!;
const previous=watch.querySelector<HTMLButtonElement>('.previous-video')!;
const next=watch.querySelector<HTMLButtonElement>('.next-video')!;
let currentId=recordings[0].id;
watch.querySelector<HTMLElement>('.player-steps')!.hidden=false;
function syncSteps(){const count=cards.filter(c=>!c.hidden).length;previous.disabled=count===0;next.disabled=count===0;}
form.addEventListener('input',syncSteps);form.addEventListener('change',syncSteps);topics.addEventListener('click',syncSteps);savedFilter.addEventListener('click',syncSteps);clear.addEventListener('click',syncSteps);document.querySelector('.empty-reset')!.addEventListener('click',syncSteps);
function select(id:string,scroll=true){
 const video=recordings.find(v=>v.id===id);if(!video)return;
 currentId=id;title.textContent=video.heading;
 watch.querySelector('.player-meta')!.textContent=`${video.publisher} · ${video.year} · ${video.format}`;
 watch.querySelector('.player-description')!.textContent=video.note;
 watch.querySelector<HTMLAnchorElement>('.player-source')!.href=video.url;
 const transcript=watch.querySelector<HTMLAnchorElement>('.player-transcript')!;
 transcript.hidden=!('transcriptUrl' in video);transcript.href='transcriptUrl' in video?video.transcriptUrl!:video.url;
 poster.href=video.url;poster.dataset.playLink=id;poster.setAttribute('aria-label',`Play: ${video.heading}`);poster.querySelector('img')!.src=video.thumbnail;
 const iframe=document.createElement('iframe');iframe.src=`https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;iframe.title=video.title;iframe.allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';iframe.allowFullscreen=true;iframe.referrerPolicy='strict-origin-when-cross-origin';frame.replaceChildren(iframe);poster.hidden=true;stop.hidden=false;
 watch.querySelector('.player-status')!.textContent='NOW PLAYING';
 document.querySelectorAll<HTMLElement>('[data-play-link]').forEach(a=>{if(a.dataset.playLink===id)a.setAttribute('aria-current','true');else a.removeAttribute('aria-current');});
 cards.forEach(c=>c.classList.toggle('is-playing',c.dataset.id===id));syncSteps();
 if(scroll){title.focus({preventScroll:true});watch.scrollIntoView({block:'start',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});}
}
function step(amount:number){const visible=cards.filter(c=>!c.hidden);if(!visible.length)return;const i=visible.findIndex(c=>c.dataset.id===currentId);const n=i<0?(amount>0?0:visible.length-1):(i+amount+visible.length)%visible.length;select(visible[n].dataset.id!,false);}
previous.addEventListener('click',()=>step(-1));next.addEventListener('click',()=>step(1));
stop.addEventListener('click',()=>{frame.replaceChildren();poster.hidden=false;stop.hidden=true;watch.querySelector('.player-status')!.textContent='READY WHEN YOU ARE';poster.focus({preventScroll:true});});
document.querySelectorAll<HTMLElement>('[data-play],[data-play-link]').forEach(link=>link.addEventListener('click',e=>{if(e instanceof MouseEvent&&(e.metaKey||e.ctrlKey||e.shiftKey||e.altKey||e.button!==0))return;e.preventDefault();select(link.dataset.play||link.dataset.playLink!);}));
const tributeNote=document.querySelector<HTMLDetailsElement>('#personal-tribute')!;
const printNote=matchMedia('print');let previousNoteState:boolean|null=null;
const expandForPrint=()=>{if(previousNoteState===null)previousNoteState=tributeNote.open;tributeNote.open=true;};
const restoreAfterPrint=()=>{if(previousNoteState!==null){tributeNote.open=previousNoteState;previousNoteState=null;}};
printNote.addEventListener('change',()=>printNote.matches?expandForPrint():restoreAfterPrint());window.addEventListener('beforeprint',expandForPrint);window.addEventListener('afterprint',restoreAfterPrint);
document.querySelectorAll<HTMLAnchorElement>('a[href="#personal-tribute"]').forEach(a=>a.addEventListener('click',()=>{document.querySelector<HTMLDetailsElement>('#personal-tribute')!.open=true;}));
document.addEventListener('click',e=>{if((e.target as Element).closest?.('[data-save]'))syncSteps();});
syncSteps();
</script>
